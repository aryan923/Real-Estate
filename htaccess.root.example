<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files
    <FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Rewrite all traffic into the /public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
